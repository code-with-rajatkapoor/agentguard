# AgentGuard configuration
# ---------------------------------------------------------------------------
# AI provider selection (backend only).
#
#   AI_PROVIDER = gemini | groq | openrouter | openai   (default: gemini)
#   AI_MODEL    = override the model id for the selected provider
#
# Only the SELECTED provider's key is required. Keys are read from the
# environment on the backend and are never sent to the browser.
#
# The AI demo mode works WITHOUT a key too: if the key is missing/placeholder
# or the request fails, AgentGuard falls back to the deterministic scripted
# agent and labels the run SCRIPTED_FALLBACK with the reason.
#
# NOUS KEY FALLBACK: when NOUS_API_KEY is empty/placeholder, AgentGuard reuses
# the Nous Portal OAuth token Hermes already holds in ~/.hermes/auth.json.
# That token is short-lived and refreshed by Hermes, so a demo machine that is
# signed in to the Nous Portal needs no key at all. On a deployed host, set
# NOUS_API_KEY explicitly.
# ---------------------------------------------------------------------------

AI_PROVIDER=gemini
AI_MODEL=

# --- nous (Nous Portal, OpenAI-compatible) ---------------------------------
NOUS_API_KEY=your_nous_api_key_here
NOUS_MODEL=meituan/longcat-2.5:free
# NOUS_BASE_URL=https://inference-api.nousresearch.com/v1/chat/completions

# --- openrouter (OpenAI-compatible) ----------------------------------------
OPENROUTER_API_KEY=

# --- openai ---------------------------------------------------------------
OPENAI_API_KEY=
# --- groq (OpenAI-compatible) ----------------------------------------------
# GroqCloud free plan: $0 (billing/plans page). Only the selected provider's
# key is required.
GROQ_API_KEY=

# --- gemini (OpenAI-compatible interface) ----------------------------------
GEMINI_API_KEY=
# AI_PROVIDER=gemini selects this provider (render.yaml sets AI_PROVIDER=gemini).
# Create the key in Google AI Studio: https://aistudio.google.com/apikey
# Paste it in Render as GEMINI_API_KEY (never in this file).
# Model: gemini-2.0-flash (see GEMINI_RENDER_SETUP.md).

# --- performance tuning ----------------------------------------------------
# Lower budgets keep a demo run snappy: a tool-call turn needs only a couple
# of hundred tokens, and a fast fallback beats a long hang.
# AI_TIMEOUT=20            # seconds before a provider call is abandoned
# AI_MAX_RETRIES=1         # retries on top of the first attempt
# AI_MAX_TOKENS=256        # output budget per model call
# AI_CACHE=1               # in-process response cache; 0 disables it.
#                           # Identical requests (the first turn of a repeat
#                           # demo run) are answered from memory.
